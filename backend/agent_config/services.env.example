# Copy sections to private local files. Do not put real keys in this template.
# Confirmed text provider. Reuses the server-only DashScope key below.
CANDID_TEXT_PROVIDER=dashscope
DASHSCOPE_TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TEXT_MODEL=deepseek-v4-pro
# Legacy gateway retained for explicitly selected CANDID_TEXT_PROVIDER=anker.
ANKER_AI_API_KEY=
ANKER_AI_BASE_URL=https://ai-router-cn-pub.anker-in.com
ANKER_AI_MODEL=hackathon/v_model/deepseek-v4-pro
# Question-clustering fallback (experimental; NOT in the default grouping path).
# qwen3.8-max is reached through the same Anker gateway above, under this router id.
CANDID_QUESTION_FALLBACK_MODEL=hackathon/v_model/qwen-max

# Confirmed speech channel and models.
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_ASR_REALTIME_MODEL=qwen-audio-3.1-asr-flash-streaming
DASHSCOPE_ASR_FILE_MODEL=qwen-audio-3.1-asr-flash-filetrans

# Confirmed allowlist in research/endpoints.json; demo has no monetary cap, requests remain bounded.
MONID_API_KEY=
MONID_BASE_URL=https://api.monid.ai
MONID_BUDGET_YUAN=

DASHSCOPE_TTS_MODEL=qwen3-tts-flash-realtime
DASHSCOPE_TTS_VOICE=Cherry
CANDID_SPEECH_ENABLED=1
# Compatibility setting; every app build retains the phone fallback alongside soundcore.
CANDID_RECORDING_MODE=hybrid
# Enable installation-scoped enrollment when hosting the fixed-server App.
CANDID_DEVICE_AUTH=1

# Remote service contract is a draft. Only sqlite is implemented currently.
CANDID_MEMORY_BACKEND=sqlite
CANDID_MEMORY_SERVICE_URL=
CANDID_MEMORY_SERVICE_KEY=
