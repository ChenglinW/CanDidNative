  "narrative": {
    "northStar": "Warm 原生沟通界面",
    "overview": "本文件是当前实现的提取记录。用户已固定的米白、紫色、橙色与系统圆角风格继续作为视觉依据；名称仅描述已有界面。业务表面约定见 `docs/PRODUCT_SURFACES.md`。\n\n应用主体是浅色 SwiftUI 界面，内容通过留白、圆角卡片和轻微描边组织。录音全屏页使用已确认的局部深色配色，连续语音对话仍使用 Warm 浅色。导航、选择器、表单、弹窗和图标依赖原生 SwiftUI 与 SF Symbols。",
    "keyCharacteristics": ["米白页面、近白卡片、紫色交互和橙色主按钮。", "系统圆角文字与原生导航，保留 Dynamic Type 的语义文字样式。", "深色录音页以原文、时间戳和状态为主要内容。"],
    "rules": [
      { "name": "The Recorder Scope Rule", "body": "全局仍是浅色；深色方案局限于录音全屏页，其 presentation 指定 `.preferredColorScheme(.dark)`，状态栏采用浅色文字。", "section": "colors" }
    ],
    "dos": ["Do 沿用 Warm 源码配色、系统圆角文字和 SF Symbols。", "Do 为录音全屏页保留局部深色 scheme 与浅色状态文字。", "Do 保留原生导航、安全区输入、Dynamic Type 语义样式与已实现的禁用反馈。", "Do 用文字与图标共同表达状态，并保留示例、草稿、待确认和原文依据标记。"],
    "donts": ["Don't 把局部深色录音方案扩展为整个应用的新视觉方向。", "Don't 新增字体或替换现有 Mascot 来改变已固定的视觉体系。", "Don't 把系统动态字体、语义颜色或原生导航伪装成已定义的固定网页 token。", "Don't 用示例截图推断真实数据、外部发送、ASR 或硬件已经通过验收。"]
  }
