{
    auto_https off
    default_sni 16.144.9.183
}

:80 {
    handle /.well-known/acme-challenge/* {
        root * /var/lib/candid-acme
        file_server
    }
    handle {
        redir https://16.144.9.183{uri} 308
    }
}

https://16.144.9.183 {
    tls /etc/caddy/tls/fullchain.pem /etc/caddy/tls/privkey.pem
    header X-Content-Type-Options nosniff
    request_body {
        max_size 30MB
    }
    reverse_proxy https://47.129.137.212 {
        header_up Host {upstream_hostport}
        flush_interval -1
    }
}
