{
    auto_https off
    default_sni 47.129.137.212
}

:80 {
    handle /.well-known/acme-challenge/* {
        root * /var/lib/candid-acme
        file_server
    }
    handle {
        redir https://47.129.137.212{uri} 308
    }
}

https://47.129.137.212 {
    tls /etc/caddy/tls/fullchain.pem /etc/caddy/tls/privkey.pem
    header X-Content-Type-Options nosniff
    request_body {
        max_size 30MB
    }
    reverse_proxy 127.0.0.1:8000 {
        flush_interval -1
    }
}
